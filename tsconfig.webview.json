{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx", // if you’re using React/TSX
    "sourceMap": true,
    "rootDirs": ["src", "core/src"],
    "outDir": "out/webview",
  },
  "include": ["src/webview/**/*", "src/shared/**/*"],
}
